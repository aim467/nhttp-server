<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %> - nhttp-server</title>
    <!-- 防闪烁：尽早应用已保存的主题与视图模式（避免先渲染网格再跳成列表） -->
    <script>
      (function () {
        var view = 'grid';
        try {
          if (localStorage.getItem('darkMode') === 'true') document.documentElement.setAttribute('data-theme', 'dark');
          if (localStorage.getItem('viewMode') === 'list') view = 'list';
        } catch (e) {}
        // 无论 localStorage 是否可用都要写入，保证视图规则始终能命中
        document.documentElement.setAttribute('data-view', view);
      })();
    </script>

    <!-- Vendor CSS -->
    <link rel="stylesheet" href="/static/css/vendor/bootstrap.min.css">
    <link rel="stylesheet" href="/static/css/vendor/bootstrap-icons.css">
    <link rel="stylesheet" href="/static/css/vendor/viewer.min.css">
    <link rel="stylesheet" href="/static/css/vendor/xgplayer.min.css">

    <!-- 项目样式 -->
    <link rel="stylesheet" href="/static/css/styles.css">
    <link rel="stylesheet" href="/static/css/components.css">

    <%
    // 文件类型 → 图标 + 主题化彩色类（.ft-*，见 styles.css）
    function getFileIcon(file) {
        if (file.isDirectory) return { icon: 'bi-folder-fill', color: 'ft-folder' };

        const ext = file.name.split('.').pop().toLowerCase();
        const map = {
            'pdf':  { icon: 'bi-file-earmark-pdf-fill',   color: 'ft-pdf' },
            'doc':  { icon: 'bi-file-earmark-word-fill',  color: 'ft-doc' },
            'docx': { icon: 'bi-file-earmark-word-fill',  color: 'ft-doc' },
            'xls':  { icon: 'bi-file-earmark-excel-fill', color: 'ft-sheet' },
            'xlsx': { icon: 'bi-file-earmark-excel-fill', color: 'ft-sheet' },
            'ppt':  { icon: 'bi-file-earmark-ppt-fill',   color: 'ft-slide' },
            'pptx': { icon: 'bi-file-earmark-ppt-fill',   color: 'ft-slide' },
            'txt':  { icon: 'bi-file-earmark-text-fill',  color: 'ft-text' },
            'md':   { icon: 'bi-markdown-fill',           color: 'ft-text' },
            'json': { icon: 'bi-filetype-json',           color: 'ft-code' },
            'js':   { icon: 'bi-filetype-js',             color: 'ft-code' },
            'ts':   { icon: 'bi-filetype-js',             color: 'ft-code' },
            'css':  { icon: 'bi-filetype-css',            color: 'ft-code' },
            'html': { icon: 'bi-filetype-html',           color: 'ft-code' },
            'zip':  { icon: 'bi-file-earmark-zip-fill',   color: 'ft-archive' },
            'rar':  { icon: 'bi-file-earmark-zip-fill',   color: 'ft-archive' },
            '7z':   { icon: 'bi-file-earmark-zip-fill',   color: 'ft-archive' },
            'tar':  { icon: 'bi-file-earmark-zip-fill',   color: 'ft-archive' },
            'gz':   { icon: 'bi-file-earmark-zip-fill',   color: 'ft-archive' },
            'mp3':  { icon: 'bi-file-earmark-music-fill', color: 'ft-audio' },
            'wav':  { icon: 'bi-file-earmark-music-fill', color: 'ft-audio' },
            'mp4':  { icon: 'bi-file-earmark-play-fill',  color: 'ft-video' },
            'mkv':  { icon: 'bi-file-earmark-play-fill',  color: 'ft-video' },
            'jpg':  { icon: 'bi-file-earmark-image-fill', color: 'ft-image' },
            'jpeg': { icon: 'bi-file-earmark-image-fill', color: 'ft-image' },
            'png':  { icon: 'bi-file-earmark-image-fill', color: 'ft-image' },
            'gif':  { icon: 'bi-file-earmark-image-fill', color: 'ft-image' },
            'svg':  { icon: 'bi-filetype-svg',            color: 'ft-image' }
        };

        if (map[ext]) return map[ext];

        if (file.mediaType === 'image') return { icon: 'bi-file-earmark-image-fill', color: 'ft-image' };
        if (file.mediaType === 'video') return { icon: 'bi-file-earmark-play-fill',  color: 'ft-video' };
        if (file.mediaType === 'audio') return { icon: 'bi-file-earmark-music-fill', color: 'ft-audio' };

        return { icon: 'bi-file-earmark-fill', color: 'ft-default' };
    }
    %>
</head>
<body class="windows-explorer">
    <!-- 头部（扁平实色） -->
    <header class="explorer-header">
        <div class="container-fluid">
            <!-- 地址栏：面包屑横向滚动；搜索在小屏占独立全宽行 -->
            <div class="address-bar">
                <div class="brand-mark d-none d-md-flex" title="nhttp-server">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="breadcrumb-nav flex-grow-1">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <i class="bi bi-hdd-network me-1"></i>
                                <span><%- breadcrumb %></span>
                            </li>
                        </ol>
                    </nav>
                </div>
                <div class="search-box">
                    <div class="search-toolbar">
                        <select id="typeFilter" class="form-select form-select-sm type-filter" title="按类型筛选" aria-label="按类型筛选">
                            <option value="all">全部类型</option>
                            <option value="folder">文件夹</option>
                            <option value="image">图片</option>
                            <option value="video">视频</option>
                            <option value="audio">音频</option>
                            <option value="pdf">PDF</option>
                            <option value="code">代码</option>
                            <option value="text">文本</option>
                            <option value="archive">压缩包</option>
                            <option value="other">其他</option>
                        </select>
                        <label class="search-recursive" title="在子目录中搜索">
                            <input type="checkbox" id="searchRecursive" class="form-check-input">
                            <span>含子目录</span>
                        </label>
                    </div>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control" id="searchInput" placeholder="搜索文件" autocomplete="off">
                    </div>
                </div>
            </div>

            <!-- 工具栏：主操作常显；排序/二维码/主题在小屏收入「更多」 -->
            <div class="toolbar d-flex align-items-center justify-content-between">
                <div class="toolbar-left d-flex align-items-center gap-2">
                    <% if (parentPath) { %>
                    <button class="btn" onclick="location.href='<%= parentPath %>'" title="返回上级">
                        <i class="bi bi-arrow-up"></i>
                    </button>
                    <% } %>
                    <button class="btn" onclick="location.reload()" title="刷新">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>

                <div class="toolbar-right d-flex align-items-center gap-2">
                    <% if (authEnabled) { %>
                    <button class="btn btn-accent" id="uploadBtn" title="上传文件">
                        <i class="bi bi-cloud-upload"></i>
                        <span class="d-none d-md-inline ms-1">上传</span>
                    </button>
                    <% } %>
                    <button type="button" class="btn" id="viewToggle" title="切换视图">
                        <i class="bi bi-list"></i>
                    </button>

                    <!-- 桌面：次要操作常显 -->
                    <div class="toolbar-secondary d-none d-md-flex align-items-center gap-2">
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="排序">
                                <i class="bi bi-sort-alpha-down"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#" data-sort="name">按名称排序</a></li>
                                <li><a class="dropdown-item" href="#" data-sort="date">按修改日期排序</a></li>
                                <li><a class="dropdown-item" href="#" data-sort="size">按大小排序</a></li>
                            </ul>
                        </div>
                        <button class="btn js-qr-share-current" title="分享当前目录二维码">
                            <i class="bi bi-qr-code"></i>
                        </button>
                        <button class="btn js-theme-toggle" title="切换主题">
                            <i class="bi bi-moon"></i>
                        </button>
                    </div>

                    <!-- 移动：次要操作收入「更多」 -->
                    <div class="dropdown d-md-none">
                        <button type="button" class="btn" id="moreActions" data-bs-toggle="dropdown" aria-expanded="false" title="更多">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">排序</h6></li>
                            <li><a class="dropdown-item" href="#" data-sort="name"><i class="bi bi-sort-alpha-down me-2"></i>按名称</a></li>
                            <li><a class="dropdown-item" href="#" data-sort="date"><i class="bi bi-calendar me-2"></i>按修改日期</a></li>
                            <li><a class="dropdown-item" href="#" data-sort="size"><i class="bi bi-hdd me-2"></i>按大小</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button type="button" class="dropdown-item js-qr-share-current">
                                    <i class="bi bi-qr-code me-2"></i>分享目录二维码
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item js-theme-toggle">
                                    <i class="bi bi-moon me-2"></i><span class="theme-toggle-label">切换主题</span>
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- 文件列表容器 -->
    <main class="file-container">
        <div class="container-fluid">
            <!-- 列表视图表头 -->
            <div class="list-header d-none">
                <div class="row">
                    <div class="col-8 col-md-4"><small>名称</small></div>
                    <div class="col-2 d-none d-md-block"><small>修改日期</small></div>
                    <div class="col-2 d-none d-md-block"><small>类型</small></div>
                    <div class="col-2 d-none d-md-block"><small>大小</small></div>
                    <div class="col-4 col-md-2 text-end"><small>操作</small></div>
                </div>
            </div>

            <!-- 递归搜索结果（默认隐藏） -->
            <div id="searchResultsBar" class="search-results-bar d-none">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span id="searchResultsSummary" class="text-secondary"></span>
                    <button type="button" class="btn btn-sm" id="clearSearchResults">
                        <i class="bi bi-x-lg me-1"></i>清除搜索
                    </button>
                </div>
            </div>
            <div id="searchResultsList" class="file-list search-results-list d-none"></div>

            <!-- 文件列表 -->
            <div id="fileList" class="file-list">
                <% fileItems.forEach(function(file) {
                    const iconData = getFileIcon(file);
                %>
                <div class="file-item <%= file.isDirectory ? 'directory' : 'file' %>"
                     data-name="<%= file.name %>"
                     data-size="<%= file.formattedSize %>"
                     data-date="<%= file.formattedDate %>"
                     data-href="<%= file.href %>"
                     data-is-directory="<%= file.isDirectory %>"
                     data-media-type="<%= file.mediaType || '' %>"
                     data-file-category="<%= file.category || 'other' %>"
                     data-bs-toggle="tooltip"
                     data-bs-html="true"
                     title="<div class='text-start'>名称: <%= file.name %><br>大小: <%= file.formattedSize %><br>修改: <%= file.formattedDate %></div>"
                     <% if (file.mediaType === 'image') { %>
                     data-viewer-image="<%= file.href %>"
                     <% } else if (file.mediaType === 'pdf') { %>
                     onclick="showMediaPreview('<%= file.href %>', 'pdf', '<%= file.name %>')"
                     <% } else if (file.mediaType) { %>
                     onclick="showMediaPreview('<%= file.href %>', '<%= file.mediaType %>', '<%= file.name %>')"
                     <% } else { %>
                     onclick="location.href='<%= file.href %>'"
                     <% } %>>

                    <!-- 网格视图 -->
                    <div class="grid-layout">
                        <div class="file-thumb<%= file.mediaType === 'image' ? ' has-thumb' : '' %>">
                            <% if (file.mediaType === 'image') { %>
                            <img src="<%= file.href %>" alt="" class="file-thumb-img" loading="lazy" decoding="async"
                                 onerror="this.classList.add('is-broken'); this.nextElementSibling.classList.add('is-fallback-visible');">
                            <i class="bi <%= iconData.icon %> <%= iconData.color %> file-thumb-fallback"></i>
                            <% } else { %>
                            <i class="bi <%= iconData.icon %> <%= iconData.color %>"></i>
                            <% } %>
                        </div>
                        <div class="file-name-grid"><%= file.name %></div>
                        <div class="file-actions-grid">
                            <% if (!file.isDirectory) { %>
                            <button class="btn btn-sm" onclick="event.stopPropagation(); previewFile('<%= file.href %>', '<%= file.mediaType %>', '<%= file.name %>')" title="预览">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-sm" onclick="event.stopPropagation(); downloadFile('<%= file.href %>', '<%= file.name %>')" title="下载">
                                <i class="bi bi-download"></i>
                            </button>
                            <button class="btn btn-sm" onclick="event.stopPropagation(); shareFileQr('<%= file.href %>', '<%= file.name %>')" title="二维码分享">
                                <i class="bi bi-qr-code"></i>
                            </button>
                            <% } %>
                        </div>
                    </div>

                    <!-- 列表视图（显示/隐藏由 .file-list.list-view 控制，勿加 d-none，
                         否则 Bootstrap 的 display:none !important 会覆盖视图切换规则） -->
                    <div class="list-layout">
                        <div class="row align-items-center">
                            <div class="col-8 col-md-4 d-flex align-items-center">
                                <div class="file-icon-small me-2">
                                    <i class="bi <%= iconData.icon %> <%= iconData.color %>"></i>
                                </div>
                                <span class="file-name-list"><%= file.name %></span>
                            </div>
                            <div class="col-2 d-none d-md-block">
                                <small class="text-secondary"><%= file.formattedDate %></small>
                            </div>
                            <div class="col-2 d-none d-md-block">
                                <small class="text-secondary">
                                    <% if (file.isDirectory) { %>文件夹<% } else { %><%= file.name.split('.').pop().toUpperCase() %> 文件<% } %>
                                </small>
                            </div>
                            <div class="col-2 d-none d-md-block">
                                <small class="text-secondary"><%= file.formattedSize %></small>
                            </div>
                            <div class="col-4 col-md-2 text-end">
                                <% if (!file.isDirectory) { %>
                                <div class="file-actions-list">
                                    <button class="btn btn-sm" onclick="event.stopPropagation(); previewFile('<%= file.href %>', '<%= file.mediaType %>', '<%= file.name %>')" title="预览">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-sm" onclick="event.stopPropagation(); downloadFile('<%= file.href %>', '<%= file.name %>')" title="下载">
                                        <i class="bi bi-download"></i>
                                    </button>
                                    <button class="btn btn-sm" onclick="event.stopPropagation(); shareFileQr('<%= file.href %>', '<%= file.name %>')" title="二维码分享">
                                        <i class="bi bi-qr-code"></i>
                                    </button>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <% if (file.mediaType === 'image') { %>
                    <img src="<%= file.href %>" alt="<%= file.name %>" class="viewer-image">
                    <% } %>
                </div>
                <% }); %>
            </div>
        </div>
    </main>

    <!-- 媒体预览模态框 -->
    <div class="modal fade" id="mediaModal" tabindex="-1" aria-labelledby="mediaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-sm-down">
            <div class="modal-content bg-dark">
                <div class="modal-header border-0">
                    <h5 class="modal-title text-white" id="mediaModalLabel">媒体预览</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-0" id="modalBody">
                    <div id="xgPlayerContainer" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- 文件预览浮窗 -->
    <div id="filePreviewPopup" class="file-preview-popup">
        <div class="file-preview-header">
            <div class="file-preview-title">
                <i class="bi bi-file-earmark-text me-2"></i>
                <span id="previewFileName">文件名</span>
            </div>
            <div class="file-preview-actions">
                <button class="btn btn-sm" onclick="openInNewTab()" title="在新标签页打开">
                    <i class="bi bi-box-arrow-up-right"></i>
                </button>
                <button class="btn btn-sm" onclick="closeFilePreview()" title="关闭">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
        <div class="file-preview-info">
            <span id="previewFileSize"><i class="bi bi-hdd me-1"></i>大小</span>
            <span id="previewFileDate"><i class="bi bi-calendar me-1"></i>修改日期</span>
            <span id="previewFileEncoding"><i class="bi bi-keyboard me-1"></i>编码</span>
            <span id="previewFileType"><i class="bi bi-file-earmark me-1"></i>类型</span>
        </div>
        <div class="file-preview-toolbar">
            <select id="encodingSelect" class="form-select form-select-sm" onchange="changeEncoding(this.value)">
                <option value="auto">自动检测</option>
                <option value="UTF-8">UTF-8</option>
                <option value="GBK">GBK/GB2312</option>
                <option value="GB18030">GB18030</option>
                <option value="Big5">Big5</option>
                <option value="Shift_JIS">Shift_JIS</option>
                <option value="EUC-KR">EUC-KR</option>
                <option value="ISO-8859-1">ISO-8859-1</option>
                <option value="windows-1252">Windows-1252</option>
            </select>
            <div class="btn-group btn-group-sm ms-2">
                <button class="btn" onclick="wrapText(true)" title="自动换行"><i class="bi bi-text-wrap"></i></button>
                <button class="btn" onclick="wrapText(false)" title="不换行"><i class="bi bi-unindent"></i></button>
            </div>
            <div class="ms-auto">
                <span class="badge bg-secondary" id="previewLineCount">0 行</span>
            </div>
        </div>
        <div class="file-preview-content" id="previewContent">
            <div class="text-center text-muted p-4">
                <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                <span>加载中...</span>
            </div>
        </div>
        <div class="file-preview-status" id="previewStatus"></div>
    </div>

    <div id="previewOverlay" class="preview-overlay" onclick="closeFilePreview()"></div>

    <!-- 快捷键帮助 -->
    <div class="modal fade" id="shortcutsModal" tabindex="-1" aria-labelledby="shortcutsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-keyboard me-2"></i>键盘快捷键</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-6"><div class="d-flex align-items-center"><kbd class="me-2">/</kbd><span>聚焦搜索</span></div></div>
                        <div class="col-6"><div class="d-flex align-items-center"><kbd class="me-2">V</kbd><span>切换视图</span></div></div>
                        <div class="col-6"><div class="d-flex align-items-center"><kbd class="me-2">T</kbd><span>切换主题</span></div></div>
                        <div class="col-6"><div class="d-flex align-items-center"><kbd class="me-2">R</kbd><span>刷新页面</span></div></div>
                        <div class="col-6"><div class="d-flex align-items-center"><kbd class="me-2">ESC</kbd><span>清除搜索</span></div></div>
                        <div class="col-6"><div class="d-flex align-items-center"><kbd class="me-2">?</kbd><span>显示帮助</span></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 二维码分享 -->
    <div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="qrModalLabel"><i class="bi bi-qr-code me-2"></i>二维码分享</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <% if (serverIPs && serverIPs.length > 0) { %>
                    <% if (serverIPs.length > 1) { %>
                    <div class="mb-3">
                        <label class="form-label small text-muted">选择网络地址</label>
                        <select class="form-select form-select-sm mx-auto" id="qrIpSelect" style="max-width: 250px;">
                            <% serverIPs.forEach(function(ip) { %><option value="<%= ip %>"><%= ip %></option><% }); %>
                        </select>
                    </div>
                    <% } else { %>
                    <input type="hidden" id="qrIpSelect" value="<%= serverIPs[0] %>">
                    <% } %>
                    <% } else { %>
                    <div class="alert alert-warning small">无法获取服务器 IP 地址</div>
                    <% } %>
                    <div class="mb-3">
                        <label class="form-label small text-muted">下载选项</label>
                        <select class="form-select form-select-sm mx-auto" id="qrDownloadMode" style="max-width: 250px;">
                            <option value="open" selected>直接打开文件/目录</option>
                            <option value="download">下载文件/文件夹</option>
                        </select>
                    </div>
                    <div id="qrCodeContainer" class="d-inline-block p-2"></div>
                    <div class="mt-3 text-muted small" id="qrUrlText"></div>
                    <div class="mt-2 text-muted small">根据下载选项在本地网络中访问或下载当前文件或目录</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 上传 -->
    <% if (authEnabled) { %>
    <div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-cloud-upload me-2"></i>上传文件到 <%= pathname %></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="upload-dropzone" id="uploadDropzone">
                        <div class="upload-dropzone-content">
                            <i class="bi bi-cloud-arrow-up display-4 text-muted mb-3"></i>
                            <p class="mb-2">拖拽文件到这里上传</p>
                            <p class="text-muted small mb-3">或点击下方按钮选择文件</p>
                            <label class="btn btn-primary">
                                <i class="bi bi-folder2-open me-1"></i>选择文件
                                <input type="file" id="fileInput" multiple hidden>
                            </label>
                        </div>
                    </div>
                    <div id="uploadFileList" class="upload-file-list mt-3">
                        <h6 class="mb-2">待上传文件 (<span id="uploadFileCount">0</span>)</h6>
                        <div id="uploadFiles" class="upload-files"></div>
                    </div>
                    <div id="uploadProgress" class="mt-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span>上传进度</span>
                            <span id="uploadProgressText">0%</span>
                        </div>
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" id="uploadProgressBar" role="progressbar" style="width: 0%"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="button" class="btn btn-success" id="startUploadBtn" disabled>
                        <i class="bi bi-upload me-1"></i>开始上传
                    </button>
                </div>
            </div>
        </div>
    </div>
    <% } %>

    <!-- 隐藏数据 -->
    <input type="hidden" id="serverPort" value="<%= currentPort %>">
    <input type="hidden" id="currentPath" value="<%= pathname %>">
    <input type="hidden" id="authEnabled" value="<%= authEnabled %>">

    <!-- 右键菜单 -->
    <div class="context-menu" id="contextMenu">
        <div class="context-menu-item" data-action="preview"><i class="bi bi-eye me-2"></i>预览</div>
        <div class="context-menu-item" data-action="download"><i class="bi bi-download me-2"></i>下载</div>
        <div class="context-menu-divider"></div>
        <div class="context-menu-item" data-action="copy-link"><i class="bi bi-link-45deg me-2"></i>复制链接</div>
        <div class="context-menu-item" data-action="open-new-tab"><i class="bi bi-box-arrow-up-right me-2"></i>在新标签页中打开</div>
    </div>

    <!-- Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="shortcutsToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <i class="bi bi-keyboard text-primary me-2"></i>
                <strong class="me-auto">快捷键提示</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">按 <kbd>?</kbd> 查看所有快捷键</div>
        </div>
    </div>

    <!-- Vendor JS -->
    <script src="/static/js/vendor/bootstrap.bundle.min.js"></script>
    <script src="/static/js/vendor/viewer.min.js"></script>
    <script src="/static/js/vendor/xgplayer.min.js"></script>
    <script src="/static/js/vendor/qrcode.min.js"></script>

    <!-- 项目脚本 -->
    <script src="/static/js/explorer.js"></script>
    <script src="/static/js/preview.js"></script>
    <script src="/static/js/upload.js"></script>
    <script src="/static/app.js"></script>
</body>
</html>
